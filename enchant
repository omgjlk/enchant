#!/usr/bin/env bash
# enchant — turn a bare macOS laptop into your equipped dev machine.
#
# Idempotent. Re-run any time. New customisation lives in:
#   - Brewfile                 (packages, casks, taps, VS Code ext, go installs)
#   - macos/defaults.sh        (macOS system preferences)
#   - lib/*.sh                 (additional spells)
#   - omgjlk/dotfiles (chezmoi source for $HOME files)
#
# Usage:
#   ./enchant            # cast the full ritual
#   ./enchant brew       # just sync Homebrew
#   ./enchant defaults   # just apply macOS defaults
#   ./enchant dotfiles   # just sync dotfiles via chezmoi
#   ./enchant shell      # switch login shell to Homebrew bash
#   ./enchant doctor     # show what's drifted from Brewfile

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_DIR"

# shellcheck source=lib/log.sh
source "$REPO_DIR/lib/log.sh"

# --- Spells ----------------------------------------------------------------

spell_preflight() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    fail "enchant currently targets macOS only (uname: $(uname -s))"
  fi
  log "macOS $(sw_vers -productVersion) on $(uname -m)"
}

spell_xcode_clt() {
  if xcode-select -p >/dev/null 2>&1; then
    ok "Xcode Command Line Tools present"
    return
  fi
  log "Installing Xcode Command Line Tools (a GUI prompt will appear)..."
  xcode-select --install || true
  until xcode-select -p >/dev/null 2>&1; do
    sleep 5
  done
  ok "Xcode Command Line Tools installed"
}

spell_prime_sudo() {
  # Some downstream spells (Homebrew install in NONINTERACTIVE mode,
  # /etc/shells edit) need sudo. Prompt for it up front so we never get a
  # silent failure mid-run, and keep the credential warm in the background.
  if sudo -n true 2>/dev/null; then
    ok "sudo credentials already cached"
  else
    log "Priming sudo (you'll be prompted for your password)..."
    sudo -v
    ok "sudo primed"
  fi
  # Always start the keep-alive loop: cached creds expire (5min default on
  # macOS, sometimes shorter), so we refresh every 50s while enchant runs.
  ( while kill -0 "$$" 2>/dev/null; do sudo -n true 2>/dev/null; sleep 50; done ) &
  log "sudo keep-alive started (pid $!)"
}

spell_homebrew() {
  # Look in known install locations first; PATH may not be set up yet if
  # this is a fresh shell after install.
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  if command -v brew >/dev/null 2>&1; then
    ok "Homebrew present ($(brew --version | head -1))"
    return
  fi
  log "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

spell_brew_bundle() {
  log "Casting Brewfile..."
  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle --file="$REPO_DIR/Brewfile"
  ok "Brewfile applied"
}

spell_dotfiles() {
  local repo="${DOTFILES_REPO:-git@github.com:omgjlk/dotfiles.git}"
  if ! command -v chezmoi >/dev/null 2>&1; then
    log "Installing chezmoi via Homebrew..."
    brew install chezmoi
  fi
  if [[ ! -d "${HOME}/.local/share/chezmoi/.git" ]]; then
    log "Initializing chezmoi from ${repo}..."
    chezmoi init "${repo}"
  else
    log "Updating chezmoi source..."
    chezmoi update --no-tty || chezmoi git -- pull --rebase
  fi
  log "Applying dotfiles..."
  chezmoi apply --keep-going
  ok "Dotfiles applied"
}

spell_shell() {
  local brew_bash
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x "$candidate" ]]; then
      brew_bash="$candidate"
      break
    fi
  done
  if [[ -z "${brew_bash:-}" ]]; then
    warn "Homebrew bash not found. Run './enchant brew' first."
    return 1
  fi
  if ! grep -qxF "$brew_bash" /etc/shells; then
    log "Adding $brew_bash to /etc/shells (sudo)..."
    echo "$brew_bash" | sudo tee -a /etc/shells >/dev/null
  else
    ok "$brew_bash already in /etc/shells"
  fi
  local current_shell
  current_shell="$(dscl . -read "/Users/${USER}" UserShell 2>/dev/null | awk '{print $2}')"
  if [[ "$current_shell" != "$brew_bash" ]]; then
    log "Changing login shell to $brew_bash..."
    chsh -s "$brew_bash"
  else
    ok "Login shell already $brew_bash"
  fi
}

spell_install_shell_dotfiles() {
  # Removed: bash dotfiles now live in the chezmoi dotfiles repo.
  fail "Deprecated. Bash dotfiles are managed by chezmoi; run './enchant dotfiles'."
}

spell_macos_defaults() {
  if [[ -x "$REPO_DIR/macos/defaults.sh" ]]; then
    log "Applying macOS defaults..."
    "$REPO_DIR/macos/defaults.sh"
    ok "macOS defaults applied"
  else
    warn "macos/defaults.sh missing or not executable; skipping"
  fi
}

spell_doctor() {
  log "Checking Brewfile drift..."
  brew bundle check --file="$REPO_DIR/Brewfile" --verbose || true
  log "Installed leaves not in Brewfile (candidates to add):"
  comm -23 \
    <(brew leaves | sort) \
    <(awk -F\" '/^brew /{print $2}' Brewfile | awk -F/ '{print $NF}' | sort) || true
  log "Installed casks not in Brewfile:"
  comm -23 \
    <(brew list --cask | sort) \
    <(awk -F\" '/^cask /{print $2}' Brewfile | sort) || true
}

# --- Dispatcher ------------------------------------------------------------

cast_all() {
  spell_preflight
  spell_xcode_clt
  spell_prime_sudo
  spell_homebrew
  spell_brew_bundle
  spell_macos_defaults
  spell_dotfiles
  ok "✨ Enchantment complete."
}

cmd="${1:-all}"
case "$cmd" in
  all)       cast_all ;;
  brew)      spell_preflight; spell_homebrew; spell_brew_bundle ;;
  defaults)  spell_preflight; spell_macos_defaults ;;
  dotfiles)  spell_preflight; spell_dotfiles ;;
  shell)     spell_preflight; spell_shell ;;
  doctor)    spell_preflight; spell_doctor ;;
  -h|--help|help)
    sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
  *)
    fail "Unknown command: $cmd (try: all | brew | defaults | dotfiles | shell | doctor)"
    ;;
esac
